# ============================================================
# 广东电力市场价格数据采集 —— 环境变量模板
# 复制为 .env 后填写真实值，切勿提交到 git
# ============================================================

# ---------- 交易中心账号（登录后才有完整字段）----------
GD_USERNAME=your_account
GD_PASSWORD=your_password

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=price_collector
DB_PASSWORD=change_me
DB_NAME=gd_power

# ---------- 采集调度 ----------
# 每日采集时刻（24小时制，多次用逗号分隔）
# 参考披露时点：
#   12:00 前 -> 负荷预测/分电源预测/必开必停
#   18:00 前 -> 实际出力/实际负荷/系统备用/通道潮流
#   22:00 前 -> 现货出清信息（含各类电源电量和台数）
COLLECT_TIMES=12:30,18:30,22:30

# ---------- 反爬与稳定性 ----------
# 每次请求随机延时区间（秒）
MIN_DELAY=2.0
MAX_DELAY=6.0
# 失败重试次数
MAX_RETRY=3

# ---------- 通知（可选）----------
# 企业微信机器人 webhook，采集成功后推送摘要
WECOM_WEBHOOK=
