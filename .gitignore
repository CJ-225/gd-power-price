# 登录态（含账号信息，绝对不能传！）
state/
auth.json
*.auth.json

# 环境变量（含密码）
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 日志（数据可以传，日志体积大且无长期价值）
logs/*.log
logs/*.png

# 系统文件
.DS_Store
Thumbs.db
